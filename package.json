{
	"name": "awesome-nsgo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Awesome NSGo: the NSGo ecosystem site, served from Cloudflare Workers",
	"license": "MIT",
	"homepage": "https://awesomensgo.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yldm-tech/awesome-nsgo.git"
	},
	"bugs": "https://github.com/yldm-tech/awesome-nsgo/issues",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "pnpm --filter @awesome-nsgo/web dev",
		"build": "pnpm --filter @awesome-nsgo/web build",
		"preview": "pnpm --filter @awesome-nsgo/web preview",
		"deploy": "pnpm --filter @awesome-nsgo/web deploy",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
