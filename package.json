{
	"name": "vibe-arcade",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Vibe Arcade: a curated index of games vibe-coded with AI and shared on X, served from Cloudflare Workers",
	"keywords": ["vibe-coding", "ai-games", "browser-games", "awesome-list", "claude", "threejs", "tanstack-start", "cloudflare-workers"],
	"author": "Wiz Games (https://wiz.games)",
	"license": "MIT",
	"homepage": "https://vibe.wiz.games",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yldm-tech/awesome-vibe-games.git"
	},
	"bugs": "https://github.com/yldm-tech/awesome-vibe-games/issues",
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"dev": "pnpm --filter @vibe-arcade/web dev",
		"build": "pnpm --filter @vibe-arcade/web build",
		"preview": "pnpm --filter @vibe-arcade/web preview",
		"deploy": "pnpm --filter @vibe-arcade/web deploy",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
