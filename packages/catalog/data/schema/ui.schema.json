{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "ui.schema.json",
	"title": "A UI component library, theme or icon set, one file per library named after its slug",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"slug",
		"name",
		"author",
		"tag",
		"surface",
		"summary",
		"repo",
		"url",
		"added"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"slug": {
			"$ref": "common.schema.json#/$defs/slug"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"author": {
			"type": "string",
			"minLength": 1
		},
		"tag": {
			"enum": [
				"theme",
				"retro",
				"icons"
			],
			"description": "The filter it appears under."
		},
		"surface": {
			"enum": [
				"go",
				"tsx",
				"both"
			],
			"description": "The kind of app its components go in: Go apps, TSX apps, or both."
		},
		"summary": {
			"$ref": "common.schema.json#/$defs/text"
		},
		"repo": {
			"$ref": "common.schema.json#/$defs/repo"
		},
		"url": {
			"$ref": "common.schema.json#/$defs/url"
		},
		"homepage": {
			"$ref": "common.schema.json#/$defs/url"
		},
		"screenshot": {
			"$ref": "common.schema.json#/$defs/screenshot"
		},
		"provisional": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"enum": [
					"screenshot"
				]
			},
			"description": "The images that stand in until the project gives its own: GitHub's card of the repository or a card drawn of it for a screenshot. The completing script sets it; the announcement's issue asks the project for them; whoever replaces one drops it from the list."
		},
		"added": {
			"$ref": "common.schema.json#/$defs/added"
		}
	}
}
