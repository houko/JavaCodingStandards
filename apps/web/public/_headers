# Headers for the static assets (Cloudflare Workers static assets read this file; wrangler never serves it). Cloudflare applies every rule that matches and joins the values of a header two rules both set, so no header is set by two rules: /* sets only the security headers, the rules below only Cache-Control. robots.txt keeps the default revalidate-every-time caching so crawlers see changes at once; sitemap.xml is not a file but a route, which sets its own header (src/routes/sitemap[.]xml.ts).

# The security headers of every file, the same as the Worker sends (src/lib/security.ts) apart from the page-only content security policy.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000

# Vite content-hashes every file name under /assets, so a changed file always gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The font files are named after their family and character range and never change in place: a new version of a family gets new file names (src/styles/fonts.css).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# These keep their names when their content changes, so they are cached for a day and may be served stale for a week while revalidating. A cover is always <slug>.webp and is overwritten when it is replaced, and the same goes for a creator's avatar; a game's share card is redrawn from its cover, name and like count on every build.
/covers/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/avatars/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-site-v2-1200x630.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-maskable-512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/site.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
