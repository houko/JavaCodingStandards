# Cache headers for the static assets (Cloudflare Workers static assets read this file; wrangler never serves it). Rules must not overlap: Cloudflare joins the values of every matching rule. robots.txt, sitemap.xml and site.webmanifest keep the default revalidate-every-time caching so crawlers see changes at once.

# Vite content-hashes every file name under /assets, so a changed file always gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Showcase media changes infrequently, so keep it in browser caches for a year. When replacing an existing asset, change its filename in the catalog so the old URL can expire naturally.
/shots/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/icons/*
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
# The README badge keeps one URL for good: projects paste it into their READMEs and the listing issues hand it out (packages/announce), so it cannot be renamed when its look changes, as the other assets are. It is cached for a day instead, so a new look reaches every README, through GitHub's image proxy too, within a day or two.
/badge.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-site-v2-1200x630.png
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/mark-32.png
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/mark-192.png
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/mark-64.webp
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/mark-512.png
  Cache-Control: public, max-age=31536000, stale-while-revalidate=604800
/apple-touch-icon.png
