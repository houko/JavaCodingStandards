{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibe-arcade",
	"account_id": "e2b27aea5f599efdbe0a7016a2580d05",
	"compatibility_date": "2026-06-20",
	"compatibility_flags": ["nodejs_compat"],
	// The Worker entry (src/server.ts): TanStack Start's handler, which server-renders every route. The client bundle and public/ are served as static assets.
	"main": "src/server.ts",
	// The site's host, the same one as SITE_URL in packages/catalog/src/site.ts; its zone (wiz.games) is on this Cloudflare account. The site has no database, no rate limiters and no secrets; its one binding is the R2 bucket of the clips.
	"routes": [
		{ "pattern": "vibe.wiz.games", "custom_domain": true },
		// Only redirects to the site's host (src/server.ts).
		{ "pattern": "www.vibe.wiz.games", "custom_domain": true },
	],
	// The clips, served by the Worker from /videos/ (src/lib/media.ts) and uploaded by scripts/fetch-media.ts. In development the binding reaches the real bucket, as the clips are not in the repository.
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vibe-arcade-media", "remote": true }],
	"observability": { "enabled": true },
	// Keep Preview URLs on (wrangler disables them when this is missing) so each pull request gets its own preview link.
	"preview_urls": true
}
