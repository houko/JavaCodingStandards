{
	"name": "@vibe-arcade/web",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Vibe Arcade site, server-rendered by TanStack Start on Cloudflare Workers",
	"scripts": {
		"dev": "vite dev --configLoader runner",
		"build": "vite build --configLoader runner",
		"preview": "vite preview --configLoader runner",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"covers": "node scripts/fetch-covers.ts",
		"media": "node scripts/fetch-media.ts",
		"icons": "node scripts/site-icons.ts",
		"banner": "node scripts/banner.ts",
		"og-fonts": "node scripts/og-cjk-fonts.ts",
		"readme": "node scripts/readme-games.ts"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.5",
		"@vibe-arcade/catalog": "workspace:*",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.69.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"satori": "^0.19.3",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"wrangler": "^4.160.1"
	},
	"engines": {
		"node": ">=24.0.0"
	}
}
